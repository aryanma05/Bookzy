{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.local", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": ["npm --prefix functions test"]
    }
  ],
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/salon/**", "destination": "/salon/[id].html" },
      { "source": "/book/**", "destination": "/book/[salonId].html" },
      { "source": "/booking/**", "destination": "/booking/[id].html" },
      { "source": "/review/**", "destination": "/review/[bookingId].html" },
      { "source": "/business/booking/**", "destination": "/business/booking/[id].html" },
      { "source": "/business/service/**", "destination": "/business/service/[id].html" },
      { "source": "/business/staff/**", "destination": "/business/staff/[id].html" },
      { "source": "**", "function": { "functionId": "salonLinkPage", "region": "europe-west1" } }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
