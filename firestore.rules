rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function slotPath(slotId) {
      return /databases/$(database)/documents/slots/$(slotId);
    }

    function salonPath(salonId) {
      return /databases/$(database)/documents/salons/$(salonId);
    }

    function reviewPath(reviewId) {
      return /databases/$(database)/documents/reviews/$(reviewId);
    }

    function isSalonOwner(salonId) {
      return signedIn() && get(salonPath(salonId)).data.get('ownerId', null) == request.auth.uid;
    }

    // Feltene eieren selv kan endre. Snitt og antall anmeldelser styres bare av anmeldelsene.
    function editableSalonFields() {
      return [
        'name', 'category', 'description', 'address', 'area', 'phone', 'locationType',
        'services', 'staff', 'openingHours', 'closedDates', 'cancellationHours', 'published', 'updatedAt'
      ];
    }

    function validSalon(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.category is string && data.category.size() <= 40
        && data.description is string && data.description.size() <= 1000
        && data.address is string && data.address.size() <= 120
        && data.area is string && data.area.size() <= 60
        && data.phone is string && data.phone.size() <= 20
        && data.locationType in ['home', 'salon']
        && data.services is list && data.services.size() <= 60
        && data.staff is list && data.staff.size() >= 1 && data.staff.size() <= 30
        && data.openingHours is map
        && data.openingHours.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && data.closedDates is list && data.closedDates.size() <= 400
        && data.cancellationHours is int && data.cancellationHours >= 0 && data.cancellationHours <= 168
        && data.published is bool
        && data.updatedAt == request.time;
    }

    // Salonger er offentlige. Seed-scriptet (Admin SDK) går utenom reglene.
    match /salons/{salonId} {
      allow read: if true;

      // Hvem som helst kan registrere en bedrift og blir da eier av den.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(editableSalonFields().concat(['ownerId', 'ratingSum', 'reviewCount', 'createdAt']))
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ratingSum == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.createdAt == request.time
        && validSalon(request.resource.data);

      allow update: if
        // Eieren redigerer salongen sin
        (signedIn()
          && resource.data.get('ownerId', null) == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableSalonFields())
          && validSalon(request.resource.data))
        // En kunde teller med en ny anmeldelse, i samme transaksjon som anmeldelsen
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'reviewCount', 'lastReviewId'])
          && request.resource.data.reviewCount == resource.data.reviewCount + 1
          && !exists(reviewPath(request.resource.data.lastReviewId))
          && getAfter(reviewPath(request.resource.data.lastReviewId)).data.salonId == salonId
          && request.resource.data.ratingSum
            == resource.data.ratingSum + getAfter(reviewPath(request.resource.data.lastReviewId)).data.rating);

      allow delete: if false;
    }

    // Profil og favoritter – bare for eieren.
    match /users/{uid} {
      allow read, delete: if isUser(uid);

      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20;

      match /favorites/{salonId} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }
    }

    // Kunden ser, oppretter og avbestiller sine egne timer. Salongen ser alle timer hos seg.
    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isSalonOwner(resource.data.salonId));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'customerName', 'customerPhone', 'note',
          'salonId', 'salonName', 'serviceId', 'serviceName', 'staffId', 'staffName',
          'durationMin', 'priceNok', 'date', 'time', 'startAt', 'endAt', 'cancellableUntil',
          'slotIds', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.createdAt == request.time
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() <= 20
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.durationMin is int
        && request.resource.data.priceNok is number
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.startAt > request.time
        && request.resource.data.endAt > request.resource.data.startAt
        // Avbestillingsfristen bestemmes av salongen, ikke av appen
        && request.resource.data.cancellableUntil
          == request.resource.data.startAt - duration.value(get(salonPath(request.resource.data.salonId)).data.cancellationHours, 'h')
        // Ikke på fridager, verken for hele salongen eller for den ansatte
        && !(request.resource.data.date in get(salonPath(request.resource.data.salonId)).data.get('closedDates', []))
        && !((request.resource.data.date + '_' + request.resource.data.staffId)
          in get(salonPath(request.resource.data.salonId)).data.get('closedDates', []))
        && request.resource.data.slotIds is list
        && request.resource.data.slotIds.size() > 0
        && request.resource.data.slotIds.size() <= 16
        // Bookingen må skrives sammen med lukene sine (samme transaksjon)
        && getAfter(slotPath(request.resource.data.slotIds[0])).data.bookingId == bookingId;

      allow update: if
        // Kunden kan bare avbestille, og bare før salongens frist
        (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'confirmed'
          && request.time < resource.data.cancellableUntil
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))
        // Salongen kan avbestille når som helst
        || (isSalonOwner(resource.data.salonId)
          && resource.data.status == 'confirmed'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.cancelledBy == 'salon'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy']))
        // ... og markere at kunden ikke møtte (eller angre det) når timen har startet
        || (isSalonOwner(resource.data.salonId)
          && request.time >= resource.data.startAt
          && ((resource.data.status == 'confirmed' && request.resource.data.status == 'noShow')
            || (resource.data.status == 'noShow' && request.resource.data.status == 'confirmed'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow delete: if false;
    }

    // Én 30-minutters luke per salong/ansatt/dato/tid. Dokumentet kan bare opprettes, aldri overskrives,
    // så to bookinger kan ikke få samme luke. Inneholder ingen persondata, så alle kan lese.
    match /slots/{slotId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['salonId', 'staffId', 'date', 'time', 'bookingId'])
        && slotId == request.resource.data.salonId + '_' + request.resource.data.staffId + '_'
          + request.resource.data.date + '_' + request.resource.data.time
        && getAfter(bookingPath(request.resource.data.bookingId)).data.userId == request.auth.uid
        && getAfter(bookingPath(request.resource.data.bookingId)).data.salonId == request.resource.data.salonId
        && getAfter(bookingPath(request.resource.data.bookingId)).data.staffId == request.resource.data.staffId
        && getAfter(bookingPath(request.resource.data.bookingId)).data.date == request.resource.data.date
        && slotId in getAfter(bookingPath(request.resource.data.bookingId)).data.slotIds;

      // Luker frigjøres bare når kunden eller salongen avbestiller bookingen i samme operasjon.
      allow delete: if signedIn()
        && (getAfter(bookingPath(resource.data.bookingId)).data.userId == request.auth.uid
          || isSalonOwner(resource.data.salonId))
        && getAfter(bookingPath(resource.data.bookingId)).data.status == 'cancelled';

      allow update: if false;
    }

    // Anmeldelser er offentlige. ID-en er bookingens ID, så hver time kan anmeldes én gang,
    // og bare av den som faktisk hadde timen.
    match /reviews/{bookingId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['salonId', 'rating', 'comment', 'authorName', 'serviceName', 'createdAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.createdAt == request.time
        && get(bookingPath(bookingId)).data.userId == request.auth.uid
        && get(bookingPath(bookingId)).data.status == 'confirmed'
        && get(bookingPath(bookingId)).data.endAt < request.time
        && get(bookingPath(bookingId)).data.salonId == request.resource.data.salonId
        && getAfter(salonPath(request.resource.data.salonId)).data.lastReviewId == bookingId;

      allow update, delete: if false;
    }
  }
}
